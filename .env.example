NMBRS_CLIENT_ID=
NMBRS_CLIENT_SECRET=
NMBRS_SUBSCRIPTION_KEY=
NMBRS_REDIRECT_URI=http://localhost:8765/callback
NMBRS_TOKEN_STORE=./.tokens.json
NMBRS_READ_ONLY=true
NMBRS_REDACT_BSN=true
# Extra scopes, spatie gescheiden. Voorbeeld: employee.bankaccount.read employee.document.read
NMBRS_EXTRA_SCOPES=
# Alleen voor remote hosting (npm run start:http): exacte publieke https-URL, zonder slash aan het eind
MCP_BASE_URL=
PORT=3000
